\name{geom_trust_point}
\alias{geom_trust_point}
\title{geom_trust_point}
\usage{
geom_trust_point(mapping = NULL, data = NULL, encoding = c("auto", "halo", "landscape"), na.rm = FALSE, show.legend = NA, inherit.aes = TRUE, ...)
}
\description{Dispatcher geom that selects between halo and landscape encoding based on point count.}
\arguments{
    \item{mapping}{Set of aesthetic mappings created by aes().}
    \item{data}{The data to be displayed.}
    \item{encoding}{Which encoding to use: auto, halo, or landscape.}
    \item{na.rm}{If FALSE, the default, missing values are removed with a warning.}
    \item{show.legend}{Logical. Should this layer be included in the legends?}
    \item{inherit.aes}{If TRUE, combine mapping with default mapping.}
    \item{...}{Other arguments passed to layer().}
}
