\name{select_encoding}
\alias{select_encoding}
\title{select_encoding}
\usage{
select_encoding(n, halo_max = trust_default("selection.halo_max"))
}
\description{Select halo or landscape encoding based on point count.}
\arguments{
    \item{n}{Number of data points.}
    \item{halo_max}{Maximum point count for halo encoding.}
}
