\name{scale_reliability_binned}
\alias{scale_reliability_binned}
\title{scale_reliability_binned}
\usage{
scale_reliability_binned(..., n_bins = 5, range = c("grey20", "#21918c"), guide = guide_reliability())
}
\description{Binned scale mapping reliability to discrete color bins.}
\arguments{
    \item{...}{Other arguments passed to scale_colour_binned().}
    \item{n_bins}{Number of discrete bins.}
    \item{range}{Vector of two colors defining the gradient.}
    \item{guide}{Guide to use for this scale.}
}
